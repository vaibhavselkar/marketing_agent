# ==========================================
# Marketing Automation Service - Environment Variables
# ==========================================

# ==========================================
# GOOGLE SERVICES
# ==========================================
# Google Cloud Service Account Email
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# Google Cloud Private Key (Copy from JSON file, escape newlines)
# Format: "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheet ID (from URL: https://docs.google.com/spreadsheets/d/[THIS_IS_THE_ID]/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Gemini AI API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# WHATSAPP SERVICES (Twilio)
# ==========================================
# Twilio Account SID
# Get from: https://console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token
# Get from: https://console.twilio.com -> Account Info
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp Number
# Format: whatsapp:+14155238886 (replace with your number)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ==========================================
# INSTAGRAM SERVICES
# ==========================================
# Instagram Access Token
# Get from: Facebook Developer Console -> Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# Facebook Page ID
# Get from: https://developers.facebook.com/tools/explorer/
INSTAGRAM_PAGE_ID=your_facebook_page_id_here

# Instagram Webhook Verification Token
# Any random string for webhook verification
INSTAGRAM_VERIFY_TOKEN=your_random_verification_token_here

# ==========================================
# EMAIL SERVICES
# ==========================================
# Gmail Address for sending emails
GMAIL_USER=your_business_email@gmail.com

# Gmail App Password
# Generate from: Google Account -> Security -> 2FA -> App Passwords
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ==========================================
# BUSINESS INFORMATION
# ==========================================
# Business owner's phone number
OWNER_PHONE=+91_your_phone_number_here

# Business owner's email
OWNER_EMAIL=your_email@business.com

# ==========================================
# OPTIONAL: ALTERNATIVE SERVICES
# ==========================================
# Telegram Bot Token (if using Telegram instead of WhatsApp)
# Get from: @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# DEVELOPMENT SETTINGS
# ==========================================
# Node.js Environment
NODE_ENV=development

# Debug mode (optional)
DEBUG=false

# ==========================================
# INSTRUCTIONS:
# ==========================================
# 1. Copy this file to .env.local
# 2. Replace all "your_..." values with actual credentials
# 3. Keep this file secure - never commit to version control
# 4. For production, set NODE_ENV=production
# 5. For free setup, focus on Google services first
# 6. WhatsApp can be manual initially to save costs